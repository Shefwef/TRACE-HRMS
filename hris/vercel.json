{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm ci",
  "crons": [
    {
      "path": "/api/cron/auto-clockout",
      "schedule": "55 17 * * *"
    },
    {
      "path": "/api/cron/generate-next-day-scrum",
      "schedule": "5 18 * * *"
    }
  ]
}
